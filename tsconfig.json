{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": [
      "bun-types"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
