[Unit]
Description=ClaudeWatch metrics service
Documentation=https://github.com/joezuchora/claudewatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as your own user. Nothing here needs root, and the store lives under $HOME.
WorkingDirectory=%h/claudewatch
ExecStart=/usr/local/bin/bun run %h/claudewatch/packages/metrics/src/cli-serve.ts
Restart=on-failure
RestartSec=5s

# Loopback by default. To reach the dashboard from another machine on your LAN, set
# CLAUDEWATCH_METRICS_HOST=0.0.0.0 AND a token — the service refuses to start otherwise.
Environment=CLAUDEWATCH_METRICS_HOST=127.0.0.1
Environment=CLAUDEWATCH_METRICS_PORT=8787
# EnvironmentFile is optional; put CLAUDEWATCH_METRICS_TOKEN there rather than in this unit,
# which is world-readable.
EnvironmentFile=-%h/.config/claudewatch/metrics.env

# Hardening. The service needs to read the repo and write one directory under $HOME.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/claudewatch-metrics
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
