{
  "name": "claudewatch",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lintBudget": "bun run scripts/lint-budget.ts",
    "fenceCheck": "bun run scripts/fence-check.ts",
    "vscodeStubCover": "bun run scripts/vscode-stub-cover.ts",
    "test": "bun test",
    "build": "bun run --filter @claudewatch/core build && bun run --filter @claudewatch/statusline build && bun run --filter claudewatch-vscode build",
    "perf": "bun run scripts/perf.ts",
    "verify": "bun run scripts/verify.ts",
    "install-statusline": "bun run --filter @claudewatch/statusline install-statusline",
    "upgrade-all:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/upgrade-all.ps1",
    "upgrade-all:linux": "bash ./scripts/upgrade-all.sh",
    "verify:plain": "bun run typecheck && bun run lint && bun run test && bun run build",
    "metrics:serve": "bun run --filter @claudewatch/metrics serve",
    "metrics:ship": "bun run --filter @claudewatch/metrics ship",
    "metrics:detect": "bun run --filter @claudewatch/metrics detect"
  },
  "devDependencies": {
    "bun-types": "^1.3.10",
    "oxlint": "1.80.0",
    "typescript": "^5.7.0"
  }
}
