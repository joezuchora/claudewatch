{
  "name": "claudewatch-vscode",
  "displayName": "ClaudeWatch",
  "description": "Shows Claude Code usage window data in the VS Code status bar",
  "publisher": "claudewatch",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/joezuchora/claudewatch"
  },
  "license": "MIT",
  "icon": "claudewatch_256x256.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "dependencies": {
    "@claudewatch/core": "workspace:*"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudewatch.refresh",
        "title": "ClaudeWatch: Refresh Now"
      },
      {
        "command": "claudewatch.openDashboard",
        "title": "ClaudeWatch: Open Usage Dashboard"
      },
      {
        "command": "claudewatch.diagnostics",
        "title": "ClaudeWatch: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "ClaudeWatch",
      "properties": {
        "claudewatch.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30
        },
        "claudewatch.warningThresholdPct": {
          "type": "number",
          "default": 70
        },
        "claudewatch.criticalThresholdPct": {
          "type": "number",
          "default": 90
        },
        "claudewatch.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "Send ClaudeWatch health metrics to a metrics service **you** host. Off by default, and always subject to VS Code's global `#telemetry.telemetryLevel#` setting \u2014 if that is off, nothing is collected regardless of this setting. Payloads contain no token, path, hostname, username, or account identifier. [What is collected](https://github.com/joezuchora/claudewatch/blob/main/SECURITY.md)."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "keywords": [
    "claude",
    "claude code",
    "usage",
    "quota",
    "status bar",
    "anthropic"
  ],
  "homepage": "https://github.com/joezuchora/claudewatch#readme",
  "bugs": {
    "url": "https://github.com/joezuchora/claudewatch/issues"
  },
  "galleryBanner": {
    "color": "#1a1a19",
    "theme": "dark"
  }
}
